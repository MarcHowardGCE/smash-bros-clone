{
  "name": "@smash/client",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "assets:validate": "tsx src/renderer/parts/validateFighterAssets.cli.ts",
    "assets:verify-determinism": "node ../../scripts/assets/verify-assets-determinism.mjs",
    "dev": "vite --port 5173",
    "build": "tsc -p tsconfig.json && vite build",
    "lint": "pnpm typecheck",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit --incremental false --composite false"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "@smash/engine": "workspace:*",
    "@smash/gamepad-input": "workspace:*",
    "@smash/server": "workspace:*",
    "@smash/shared": "workspace:*",
    "pixi.js": "^8.19.0",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@assetpack/core": "1.7.0",
    "@types/pngjs": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^30.0.1",
    "pngjs": "^7.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vitest": "^1.6.1"
  }
}
