{
  "name": "smash-clone",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "dev": "concurrently \"pnpm -F @smash/client dev\" \"pnpm -F @smash/server dev\"",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "test:e2e": "playwright test",
    "lint": "pnpm typecheck",
    "start": "node apps/server/dist/index.js",
    "deploy:render": "echo 'Push to GitHub and connect repo to Render.com'",
    "deploy:fly": "fly deploy --config fly.toml",
    "test:e2e:visual": "playwright test apps/client/e2e/todo-12-swap-proof.spec.ts apps/client/e2e/f3-visual-baselines.spec.ts",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "concurrently": "^8.0.0",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.61.1",
    "pngjs": "^7.0.0",
    "typescript": "^5.0.0"
  }
}
